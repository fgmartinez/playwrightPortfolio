{
  "name": "playwright-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Playwright UI and API test suite for Cypress Real World App.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
